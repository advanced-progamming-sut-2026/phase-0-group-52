# ============================================================

# Logs, temporary files, and local caches

# ============================================================

*.log
logs/
tmp/
temp/
.cache/
*.tmp
*.swp
*.swo
*.bak
*.orig

# ============================================================

# Local configuration and secrets

# ============================================================

.env
.env.*
*.local
application-local.properties
application-local.yml
application-local.yaml

# SSH keys must never be committed

.ssh/
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# ============================================================

# Runtime save data

# ============================================================

# Keep the directory itself, but do not commit personal saves.

assets/save/*
!assets/save/.gitkeep

# UserRepository/QuestRepository write here (users.json, quests.json); any
# leftover SQLite file would also land here. Keep the folder, not its contents.

database/*
!database/.gitkeep
*.db

# Add additional generated save locations here if needed:

# src/main/resources/save/*

# !src/main/resources/save/.gitkeep

# ============================================================

# Test output and coverage reports

# ============================================================

coverage/
reports/
test-results/
surefire-reports/
failsafe-reports/

# ============================================================

# Archives and generated files

# ============================================================

*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Temporary Files

~*

# ============================================================

# Downloaded/exported clutter (browser shortcuts, saved-webpage assets)

# ============================================================

*.url
*.lnk
*_files/

# ============================================================

# Keep intentionally tracked project files

# ============================================================

# Do not ignore:

# - README.md

# - build.gradle

# - settings.gradle

# - gradlew / gradlew.bat / gradle/wrapper/

# - docs/

# - assets/data/

# - src/

# - checkstyle.xml

# - pmd-ruleset.xml
